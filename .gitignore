# Cloned Antispam Bee checkouts (produced by clone-asb.sh)
/versions/

# Per-version plugin copy each environment activates
/wp-env/active-plugin/
/ddev/active-plugin/

# DDEV project state + downloaded WordPress core
/ddev/.ddev/
/ddev/wp/

# Benchmark output
/logs/

# Corpus dump (large binary test data; not source)
/dumps/

# Transient driver/comparer copies made by ddev scripts at runtime
/ddev/asb-driver.php
/ddev/asb-comparer.php

# Personal / local Claude Code config (not shared)
/.claude/settings.local.json
/CLAUDE.local.md
